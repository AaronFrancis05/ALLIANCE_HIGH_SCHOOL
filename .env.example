# Copy to .env and adjust. Never commit .env.

# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://ahsn:ahsn_dev_pw@localhost:5433/ahsn
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# --- Object storage (MinIO locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=ahsn_minio
S3_SECRET_ACCESS_KEY=ahsn_minio_dev_pw
S3_MEDIA_BUCKET=alliance-media
S3_PRIVATE_BUCKET=alliance-private
# Public base URL for media files (production: https://media.<domain>)
S3_MEDIA_PUBLIC_URL=http://localhost:9000/alliance-media
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@alliancehigh.sc.ug
EMAIL_FROM_NAME=Alliance High School Nansana

# --- SMS: "console" logs messages locally; "africastalking" in production ---
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Cloudflare Turnstile (these are Cloudflare's always-pass test keys) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false

# --- Security ---
# Staff two-factor is enforced when true. Keep true everywhere except automated tests.
STAFF_2FA_REQUIRED=true
